# 后端运行时配置模板。复制为 .env 并按需填写真实值。
# .env 含敏感信息，已被 .gitignore 忽略，请勿提交。

# ----------------------------- 存储（MinIO） ----------------------------- #
# 存储后端：local（本地磁盘，默认零依赖）或 minio（对象存储）。
STORAGE_BACKEND=minio
# MinIO 服务地址，可带 http(s):// 前缀（用于推断是否启用 TLS）。
MINIO_ENDPOINT=https://minio.example.com
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=file-upload-system

# ----------------------------- 邮件（SMTP） ------------------------------ #
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=notify@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=notify@example.com
# TLS 模式：auto（按端口推断）/ ssl（隐式 TLS）/ starttls / none
SMTP_TLS=auto
# 是否允许无效/自签名证书（true 时跳过证书校验）
SMTP_ALLOW_INVALID_CERTS=false
# 可选：当容器/WSL 不能直连 SMTP 端口时，通过 HTTP CONNECT 代理转发。
# SMTP_PROXY=http://172.18.80.1:7890

# ------------------------------- 其它 ----------------------------------- #
# JWT 签名密钥（生产环境务必改为强随机值）
# AUTH_SECRET_KEY=change-me-in-production
