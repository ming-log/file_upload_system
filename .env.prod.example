# Copy this file to .env.prod on the server, then fill real values.
# Do not commit .env.prod.

# Public HTTP port exposed by the frontend container.
FRONTEND_PORT=8880

# Browser origin used to access the site. Use your real domain or server IP.
# Examples:
# CORS_ORIGINS=https://homework.example.com
# CORS_ORIGINS=http://your-server-ip
CORS_ORIGINS=http://your-server-ip

# JWT signing secret. Replace with a long random value before production use.
# Example: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Initial admin account. The startup command is idempotent:
# it creates this account only when no admin/account already exists.
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=系统管理员

# SQLite database under the container /data directory.
# docker-compose.prod.yml maps ./data/backend on the server to /data.
DATABASE_URL=sqlite+pysqlite:////data/homework.db

# File storage.
# Default: local disk under ./data/backend/uploaded_files on the server.
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploaded_files

# Optional MinIO/object storage. Enable by setting STORAGE_BACKEND=minio
# and filling the values below.
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=https://minio.example.com
# MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=file-upload-system
# MINIO_SECURE=true

# SMTP settings for email verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=notify@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=notify@example.com
SMTP_TLS=auto
SMTP_ALLOW_INVALID_CERTS=false

# Optional HTTP CONNECT proxy for SMTP only.
# Leave empty on normal servers.
# SMTP_PROXY=
